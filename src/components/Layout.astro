---
import "../styles/global.css";
import "../styles/card.css";

interface Props {
  title: string;
  description: string;
  permalink: string;
  ogImage: string;
  noindex?: boolean | undefined;
}

const { title, description, permalink, ogImage, noindex = false } = Astro.props;
const site = Astro.site?.toString().replace(/\/+$/, "") ?? "";
const canonical = permalink.startsWith("http") ? permalink : `${site}${permalink}`;
const image = ogImage.startsWith("http") ? ogImage : `${site}${ogImage}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0A0A0A" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to rolodex</a>
    <header class="site-header">
      <p class="kicker">rolodex</p>
      <h1 class="glitch-title" data-text="greyZ aliases">greyZ aliases</h1>
      <hr class="header-rule" />
      <p class="lede">
        A business-card rolodex of Kaspars Greizis (greyZ) online. Flip an alias,
        read the spelling variants, and see whether each service is his, someone
        else's, free, or still unknown.
      </p>
    </header>
    <slot />
    <footer class="site-footer">
      <p>
        Public identities only. Unconfirmed aliases stay labelled. Availability
        is checked off-browser; ambiguous results stay unknown.
      </p>
    </footer>
    <div class="toast" data-toast role="status" aria-live="polite"></div>
  </body>
</html>
